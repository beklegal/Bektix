# Local development defaults. Set real production values in Vercel Environment Variables.
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Neon Postgres connection string. Prefer the pooled Neon URL for deployed/serverless usage.
DATABASE_URL="__NEON_DATABASE_URL__"

# JWT secret used to sign auth cookies. Replace locally if you run the server.
JWT_SECRET="dev-secret-change-me-to-a-long-random-string-1234"

# Optional local bootstrap credentials for development only.
SUPER_ADMIN_BOOTSTRAP_EMAIL="admin@bektix.local"
SUPER_ADMIN_BOOTSTRAP_PASSWORD="change-this-before-deploying"

# paystack credentials for local development. Replace with your own in production.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=<random secret, at least 32 characters>
PAYMENTS_RECONCILIATION_SECRET=<random secret, at least 32 characters>
APP_URL=https://your-production-domain.com