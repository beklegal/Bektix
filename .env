# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Neon Postgres (server-side). Keep secret.
# For serverless deployments (Vercel/Netlify), prefer Neon’s *pooled* connection string (host often includes `-pooler`)
# to avoid exhausting connection limits. It typically ends with `?sslmode=require`.
# Example: postgres://user:password@abc123-pooler.us-east-1.neon.tech/dbname?sslmode=require
DATABASE_URL="__NEON_DATABASE_URL__"

# JWT secret used to sign auth cookies (min 32 chars). Keep secret.
# In development, a fallback secret is available, but you should replace this with a strong value.
JWT_SECRET="dev-secret-change-me-to-a-long-random-string-1234"

# Active Neon DB connection string. When using Neon for local dev, set this to your Neon direct URL.
# DATABASE_URL="postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require"

# When no database is available, you can run the frontend only by setting SKIP_SERVER_ON_DEV=1.
# This disables the backend middleware during Vite dev and avoids requiring a running database.
# SKIP_SERVER_ON_DEV=1

# Optional: create or update the Jilkem owner account automatically on startup.
# Use Samuel Kissi's real owner email and a strong password in deployment.
OWNER_BOOTSTRAP_EMAIL="samuelkissi@gmail.com"
OWNER_BOOTSTRAP_PASSWORD="JilkemAdmin2026!"
